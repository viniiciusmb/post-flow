<%- include('../partials/header') %>

<h1>Meu Painel</h1>

<article>
  <h3>Conta TikTok</h3>
  <% if (tiktokAccount) { %>
    <p>Conectada: <strong><%= tiktokAccount.display_name || tiktokAccount.tiktok_open_id %></strong></p>
  <% } else { %>
    <p>Nenhuma conta TikTok conectada ainda.</p>
    <button disabled title="Disponivel na proxima fase do projeto">Conectar TikTok (em breve)</button>
  <% } %>
</article>

<h2>Meus vídeos</h2>
<% if (postings.length === 0) { %>
  <p class="empty-state">Nenhum video seu foi processado ainda. Assim que a integracao com o Drive estiver ativa, eles vao aparecer aqui.</p>
<% } else { %>
  <figure>
    <table>
      <thead>
        <tr><th>Video</th><th>Status</th><th>Atualizado em</th></tr>
      </thead>
      <tbody>
        <% postings.forEach(function (p) { %>
          <tr>
            <td><%= p.filename %></td>
            <td><%- include('../partials/status-badge', { status: p.status }) %></td>
            <td><%= new Date(p.updated_at).toLocaleString('pt-BR') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </figure>
<% } %>

<%- include('../partials/footer') %>
