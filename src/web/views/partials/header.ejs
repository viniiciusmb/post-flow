<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Post Flow</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="container-fluid">
    <ul>
      <li><strong>Post Flow</strong></li>
    </ul>
    <ul>
      <% if (currentUser) { %>
        <% if (currentUser.role === 'admin') { %>
          <li><a href="/admin">Painel</a></li>
          <li><a href="/admin/clients">Clientes</a></li>
          <li><a href="/admin/postings">Postagens</a></li>
          <li><a href="/admin/queue">Fila de Processamento</a></li>
        <% } else { %>
          <li><a href="/client">Meu Painel</a></li>
        <% } %>
        <li>
          <form action="/logout" method="post" style="margin:0">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="submit" class="secondary outline"><%= currentUser.email %> · Sair</button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/login">Entrar</a></li>
      <% } %>
    </ul>
  </nav>
  <main class="container">
