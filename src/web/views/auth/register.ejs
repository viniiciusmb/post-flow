<%- include('../partials/public-header') %>

<div class="wrap">
  <article class="doc" style="max-width: 25rem; padding-top: clamp(2.5rem, 5vw, 4rem)">
    <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.25rem)"><%= t('cadastro.titulo') %></h1>
    <p style="margin-bottom: 0"><%= t('cadastro.subtitulo') %></p>

    <% if (error) { %>
      <p class="erro" style="margin-top: 1.5rem"><%= error %></p>
    <% } %>

    <form method="post" action="/register" class="form">
      <label>
        <%= t('cadastro.nomeNegocio') %>
        <span style="color: var(--muted); font-weight: 400"><%= t('cadastro.opcional') %></span>
        <input type="text" name="businessName" autocomplete="organization"
               value="<%= locals.values && locals.values.businessName || '' %>">
      </label>
      <label>
        <%= t('cadastro.email') %>
        <input type="email" name="email" required autocomplete="email"
               value="<%= locals.values && locals.values.email || '' %>">
      </label>
      <label>
        <%= t('cadastro.senha') %>
        <input type="password" name="password" required minlength="8" autocomplete="new-password">
        <small><%= t('cadastro.peloMenos8') %></small>
      </label>

      <%# O `required` do HTML só vale dentro do navegador: um POST direto passa
          por cima dele. A checagem que conta é a do servidor, em authController. %>
      <label class="check">
        <input type="checkbox" name="acceptedTerms" value="1" required>
        <span><%- t('cadastro.aceite') %></span>
      </label>

      <button type="submit" class="btn btn-primary btn-lg"><%= t('cadastro.titulo') %></button>
    </form>

    <p style="margin-top: 1.75rem">
      <%= t('cadastro.jaTemConta') %>
      <%# O plano escolhido já está na sessão, então ir pro login não perde a
          escolha: quem entra por lá também cai no checkout. %>
      <a href="/login" style="color: var(--signal)"><%= t('cadastro.entrar') %></a>
    </p>
  </article>
</div>

<%- include('../partials/public-footer') %>
