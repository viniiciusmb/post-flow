<%- include('../partials/public-header') %>

<div class="wrap">
  <article class="doc" style="max-width: 25rem; padding-top: clamp(2.5rem, 5vw, 4rem)">
    <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.25rem)">Entrar</h1>

    <% if (error) { %>
      <p class="erro" style="margin-top: 1.5rem"><%= error %></p>
    <% } %>

    <form method="post" action="/login" class="form">
      <label>
        E-mail
        <input type="email" name="email" required autofocus autocomplete="email">
      </label>
      <label>
        Senha
        <input type="password" name="password" required autocomplete="current-password">
      </label>
      <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
    </form>

    <p style="margin-top: 1.75rem">
      Ainda não tem conta? <a href="/register" style="color: var(--signal)">Criar conta</a>
    </p>
  </article>
</div>

<%- include('../partials/public-footer') %>
