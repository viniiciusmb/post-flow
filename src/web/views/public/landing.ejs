<%- include('../partials/public-header') %>

<section class="hero">
  <div class="wrap">
    <p class="selo-hero">
      <%- include('../partials/logo-youtube') %>
      YouTube
      <span class="selo-seta" aria-hidden="true">→</span>
      <%- include('../partials/logo-tiktok') %>
      TikTok
      <span class="selo-texto"><%= t('landing.selo') %></span>
    </p>

    <h1><%= t('landing.h1a') %><br><%= t('landing.h1b') %> <em><%= t('landing.h1c') %></em>.</h1>
    <p class="lead">
      <%= t('landing.lead') %> <strong><%= t('landing.leadForte') %></strong>
    </p>
    <div class="cta-linha">
      <a class="btn btn-primary btn-lg" href="/register"><%= t('nav.criarConta') %></a>
      <a class="btn btn-ghost btn-lg" href="#como-funciona"><%= t('landing.verComoFunciona') %></a>
    </div>
    <p class="nota"><%= t('landing.notaHero') %></p>

    <%# Video mudo em loop com prints REAIS da plataforma (canal sendo
        adicionado, estilo de corte, TikTok conectado) - substituiu o duo
        macbook+iphone estático: explica em segundos o que antes exigia ler os
        cartões de "como funciona" mais abaixo. Só em português (mesma
        limitação já aceita no video de fluxo da seção seguinte - re-gravar
        por idioma é trabalho grande pra um ganho pequeno). Gerado com
        Remotion, fonte em /marketing-video. %>
    <video
      class="hero-video"
      src="/video/tutorial-passo-a-passo.mp4"
      poster="/video/tutorial-passo-a-passo-poster.jpg"
      width="1620" height="1000"
      autoplay muted loop playsinline preload="auto" fetchpriority="high"
      aria-label="<%= t('landing.tutorialVideoAlt') %>"
    ></video>
  </div>
</section>

<section class="secao" id="como-funciona">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 3.5rem">
      <p class="eyebrow"><%= t('nav.comoFunciona') %></p>
      <h2><%= t('landing.comoFuncionaTitulo') %></h2>
    </div>

    <div class="passos">
      <% t('landing.passos').forEach(function (passo) { %>
        <div class="passo">
          <h3><%= passo.h %></h3>
          <p><%= passo.p %></p>
        </div>
      <% }); %>
    </div>

    <%# Video mudo, em loop, sem controles - pensado pra parecer parte da
        propria pagina (nao um player incorporado). Mostra exatamente o que o
        titulo desta secao ja diz em texto ("voce participa da primeira
        etapa"): vídeo novo no YouTube, o Post Flow cortando em clipes
        verticais, publicação automática no TikTok. Gerado com Remotion,
        fonte em /marketing-video (fora do build do site - so o .mp4
        renderizado entra aqui).

        data-lazy-src (nao src) + sem autoplay: fica abaixo da dobra, entao so
        baixa quando chega perto da tela (ver o IntersectionObserver em
        public.js) - assim ele nao disputa banda com o video da hero logo na
        abertura da pagina.

        Dois videos, nao um so: no celular, o video horizontal encolhido pra
        caber na largura da tela deixava o texto desenhado dentro dele
        ilegível (e rolagem horizontal só nessa faixa da página era uma
        experiência ruim por si só). Existe uma composição Remotion SEPARADA
        (FluxoAutomaticoVertical, mesma animação, eixo vertical) pensada pra
        caber na largura do celular sem encolher o texto. A troca entre os
        dois é só CSS (media query liga/desliga um dos dois com
        display:none) - o elemento escondido nunca entra em interseção, entao
        o IntersectionObserver que já existe nunca baixa o video errado. %>
    <div class="fluxo-video-envolt">
      <video
        class="fluxo-video fluxo-video-horizontal"
        data-lazy-src="/video/fluxo-automatico.mp4"
        poster="/video/fluxo-automatico-poster.jpg"
        width="1550" height="730"
        muted loop playsinline
        aria-label="<%= t('landing.fluxoVideoAlt') %>"
      ></video>
      <video
        class="fluxo-video fluxo-video-vertical"
        data-lazy-src="/video/fluxo-automatico-vertical.mp4"
        poster="/video/fluxo-automatico-vertical-poster.jpg"
        width="764" height="1506"
        muted loop playsinline
        aria-label="<%= t('landing.fluxoVideoAlt') %>"
      ></video>
    </div>

    <div class="narrow" style="margin: clamp(3rem, 6vw, 4.5rem) auto 0; text-align: center">
      <p class="eyebrow"><%= t('landing.telasOlho') %></p>
      <h2><%= t('landing.telasTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.telasTexto') %></p>
    </div>

    <div class="duo">
      <div class="macbook">
        <div class="macbook-tampa">
          <div class="macbook-tela">
            <img
              <%# Mesmo print da hero antiga - o arquivo continua sendo
                  gerado a partir do próprio painel, por idioma. %>
              src="/img/produto/cortes-light<%= lang === 'pt' ? '' : '-' + lang %>.png"
              alt="<%= t('landing.altComputador') %>"
              width="2880" height="1800" loading="lazy">
          </div>
        </div>
        <div class="macbook-base"></div>
      </div>

      <div class="iphone">
        <div class="iphone-tela">
          <img
            src="/img/produto/cortes-mobile<%= lang === 'pt' ? '' : '-' + lang %>.png"
            alt="<%= t('landing.altCelular') %>"
            width="1170" height="2532" loading="lazy">
        </div>
      </div>
    </div>
  </div>
</section>

<section class="secao secao-mist">
  <div class="wrap whats-grid">
    <div class="whats-texto">
      <p class="eyebrow"><%= t('landing.whatsOlho') %></p>
      <h2><%= t('landing.whatsTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.whatsTexto') %></p>
    </div>
    <div class="whats-banner">
      <%- include('../partials/whatsapp-banner') %>
    </div>
  </div>
</section>

<section class="secao secao-mist" id="recursos">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 3rem">
      <p class="eyebrow"><%= t('landing.recursosOlho') %></p>
      <h2><%= t('landing.recursosTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.recursosTexto') %></p>
    </div>

    <%# Carrossel, não grade: 9 caixas de texto puro empilhadas viravam uma
        parede ilegível no celular. Cada cartão ganhou um "print" em
        miniatura (desenhado em HTML/CSS, não uma captura de tela de
        verdade - um print real de cada tela encolhido pra ~260px de largura
        vira texto ilegível, o problema que a seção "grade de recursos"
        antiga já tinha) que ilustra especificamente aquela funcionalidade,
        reaproveitando o mesmo cartão-celular (a saída sempre vertical do
        produto) como base visual comum. Rola por toque/mouse/trackpad + as
        setas (JS em public.js: recursos-carrossel). %>
    <%
      // Cartao-celular reutilizado como base visual de quase todo print -
      // representa o clipe vertical que o produto gera. innerHtml entra
      // dentro da "tela" (fundo cinza claro por padrao).
      function fone(innerHtml, telaFundo) {
        return '<div style="position:relative;flex:none;width:54px;height:96px;border-radius:11px;background:#0a0a0c;padding:3px;box-shadow:0 8px 16px -8px rgba(8,9,10,.35)">' +
          '<div style="width:100%;height:100%;border-radius:8px;background:' + (telaFundo || '#eceef1') + ';overflow:hidden;position:relative">' + innerHtml + '</div>' +
        '</div>';
      }
      var recursosPrints = [
        // 1. Estilo visual do corte: legenda queimada em balao na parte de baixo
        fone('<div style="position:absolute;left:4px;right:4px;bottom:10px;background:#4f46e5;border-radius:999px;padding:3px 4px;text-align:center;white-space:nowrap;font:700 7px Inter,sans-serif;color:#fff">' + t('landing.recursosLegenda') + '</div>'),
        // 2. Enquadramento na mao: cantos de crop + moldura interna arrastavel
        fone('<div style="position:absolute;inset:10px;border:1.5px dashed rgba(79,70,229,.7);border-radius:4px"></div>' +
          '<span style="position:absolute;left:2px;top:2px;width:9px;height:9px;border-top:2px solid #4f46e5;border-left:2px solid #4f46e5"></span>' +
          '<span style="position:absolute;right:2px;top:2px;width:9px;height:9px;border-top:2px solid #4f46e5;border-right:2px solid #4f46e5"></span>' +
          '<span style="position:absolute;left:2px;bottom:2px;width:9px;height:9px;border-bottom:2px solid #4f46e5;border-left:2px solid #4f46e5"></span>' +
          '<span style="position:absolute;right:2px;bottom:2px;width:9px;height:9px;border-bottom:2px solid #4f46e5;border-right:2px solid #4f46e5"></span>'),
        // 3. Imagem de fundo: fundo em degrade em vez do cinza padrao
        fone('', 'linear-gradient(160deg,#25f4ee,#4f46e5 55%,#fe2c55)'),
        // 4. Numeracao de serie: selo "Parte 1" no canto
        fone('<div style="position:absolute;left:4px;top:4px;background:rgba(8,9,10,.72);border-radius:999px;padding:2px 6px;white-space:nowrap;font:700 7px Inter,sans-serif;color:#fff">' + t('landing.recursosParte1') + '</div>'),
        // 5. Configuracao por canal: 3 canais em lista, cada um com engrenagem
        '<div style="display:flex;flex-direction:column;gap:7px;width:150px">' +
          [['#ff0000', t('landing.recursosCanal', { letra: 'A' })], ['#4f46e5', t('landing.recursosCanal', { letra: 'B' })], ['#111', t('landing.recursosCanal', { letra: 'C' })]].map(function (c) {
            return '<div style="display:flex;align-items:center;gap:7px;background:#fff;border:1px solid #e7e7ea;border-radius:8px;padding:5px 8px">' +
              '<span style="width:14px;height:14px;border-radius:50%;background:' + c[0] + ';flex:none"></span>' +
              '<span style="font:600 9px Inter,sans-serif;color:#08090a;flex:1">' + c[1] + '</span>' +
              '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#6b7075" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>' +
            '</div>';
          }).join('') +
        '</div>',
        // 6. Descricao automatica: balao de texto com linhas + estrela de IA
        '<div style="position:relative;background:#fff;border:1px solid #e7e7ea;border-radius:10px;padding:10px 12px;width:160px">' +
          '<div style="height:6px;border-radius:3px;background:#e7e7ea;margin-bottom:5px;width:92%"></div>' +
          '<div style="height:6px;border-radius:3px;background:#e7e7ea;margin-bottom:5px;width:100%"></div>' +
          '<div style="height:6px;border-radius:3px;background:#e7e7ea;width:65%"></div>' +
          '<span style="position:absolute;top:-7px;right:-7px;width:22px;height:22px;border-radius:50%;background:#4f46e5;display:flex;align-items:center;justify-content:center">' +
            '<svg width="12" height="12" viewBox="0 0 24 24" fill="#fff"><path d="M12 2l2 7 7 2-7 2-2 7-2-7-7-2 7-2z"/></svg>' +
          '</span>' +
        '</div>',
        // 7. Um canal, varias contas: youtube conectando a 2 contas de tiktok
        '<div style="display:flex;align-items:center;gap:14px">' +
          '<div style="width:34px;height:34px;border-radius:50%;background:#fff;border:1px solid #e7e7ea;display:flex;align-items:center;justify-content:center;flex:none">' +
            '<svg width="16" height="12" viewBox="0 0 28 20"><path fill="#FF0000" d="M27.4 3.1a3.5 3.5 0 0 0-2.5-2.5C22.7 0 14 0 14 0S5.3 0 3.1.6A3.5 3.5 0 0 0 .6 3.1 36.5 36.5 0 0 0 0 10a36.5 36.5 0 0 0 .6 6.9 3.5 3.5 0 0 0 2.5 2.5C5.3 20 14 20 14 20s8.7 0 10.9-.6a3.5 3.5 0 0 0 2.5-2.5A36.5 36.5 0 0 0 28 10a36.5 36.5 0 0 0-.6-6.9Z"/><path fill="#fff" d="M11.2 14.3 18.5 10l-7.3-4.3v8.6Z"/></svg>' +
          '</div>' +
          '<svg width="26" height="30" viewBox="0 0 26 30"><path d="M1 15h16M17 15l-9-9M17 15l-9 9M1 4h20M1 26h20" fill="none" stroke="#c7c9ce" stroke-width="1.6" stroke-linecap="round"/></svg>' +
          '<div style="display:flex;flex-direction:column;gap:8px">' +
            '<div style="width:26px;height:26px;border-radius:50%;background:#08090a;display:flex;align-items:center;justify-content:center"><svg width="12" height="12" viewBox="0 0 24 24"><path fill="#25F4EE" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" transform="translate(-0.9,-0.6)"/><path fill="#FE2C55" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" transform="translate(0.9,0.6)"/><path fill="#000" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></div>' +
            '<div style="width:26px;height:26px;border-radius:50%;background:#08090a;display:flex;align-items:center;justify-content:center"><svg width="12" height="12" viewBox="0 0 24 24"><path fill="#fff" fill-rule="evenodd" d="M5.5 4.5h13A4.5 4.5 0 0 1 23 9v6a4.5 4.5 0 0 1-4.5 4.5h-13A4.5 4.5 0 0 1 1 15V9a4.5 4.5 0 0 1 4.5-4.5Zm0 2A2.5 2.5 0 0 0 3 9v6a2.5 2.5 0 0 0 2.5 2.5h13A2.5 2.5 0 0 0 21 15V9a2.5 2.5 0 0 0-2.5-2.5h-13Z"/><rect x="9.5" y="1.5" width="5" height="21" rx="2.5" fill="#fff"/></svg></div>' +
          '</div>' +
        '</div>',
        // 8. Horarios que voce escolhe: 4 horarios fixos em chips
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px">' +
          ['08:00','12:00','16:00','20:00'].map(function (h) {
            return '<span style="display:flex;align-items:center;gap:4px;background:#fff;border:1px solid #e7e7ea;border-radius:999px;padding:4px 9px;font:700 10px Inter,sans-serif;color:#08090a">' +
              '<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.4"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>' + h +
            '</span>';
          }).join('') +
        '</div>',
        // 9. Copia no Google Drive: clipe indo pra uma pasta com check
        '<div style="display:flex;align-items:center;gap:12px">' +
          fone('') +
          '<svg width="20" height="16" viewBox="0 0 24 16"><path d="M1 8h20M15 1l7 7-7 7" fill="none" stroke="#c7c9ce" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
          '<div style="position:relative">' +
            '<svg width="38" height="30" viewBox="0 0 24 20"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h5l2 2.5h10A1.5 1.5 0 0 1 22 6v10.5A1.5 1.5 0 0 1 20.5 18h-17A1.5 1.5 0 0 1 2 16.5Z" fill="#eef0ff" stroke="#4f46e5" stroke-width="1.3"/></svg>' +
            '<span style="position:absolute;right:-5px;bottom:-5px;width:16px;height:16px;border-radius:50%;background:#15803d;display:flex;align-items:center;justify-content:center">' +
              '<svg width="9" height="9" viewBox="0 0 16 16"><path d="M3 8.5 6.3 12 13 4" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
            '</span>' +
          '</div>' +
        '</div>',
      ];
    %>
    <div class="recursos-carrossel-envolt">
      <button type="button" class="recursos-seta recursos-seta-esq" data-direcao="-1" aria-label="<%= t('landing.recursosAnterior') %>">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="recursos-carrossel" id="recursos-carrossel" tabindex="0" role="region" aria-label="<%= t('landing.recursosOlho') %>">
        <% t('landing.recursos').forEach(function (r, i) { %>
          <article class="recurso-card">
            <div class="recurso-print">
              <div class="recurso-print-chrome">
                <span></span><span></span><span></span>
              </div>
              <div class="recurso-print-conteudo"><%- recursosPrints[i] %></div>
            </div>
            <span class="recurso-indice"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= r.h %></h3>
            <p><%= r.p %></p>
          </article>
        <% }); %>
      </div>
      <button type="button" class="recursos-seta recursos-seta-dir" data-direcao="1" aria-label="<%= t('landing.recursosProximo') %>">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="recursos-pontos" id="recursos-pontos" aria-hidden="true">
      <% t('landing.recursos').forEach(function (_, i) { %>
        <span class="recursos-ponto" data-indice="<%= i %>"></span>
      <% }); %>
    </div>
  </div>
</section>

<section class="secao secao-mist" id="planos">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 3rem">
      <p class="eyebrow"><%= t('landing.planosOlho') %></p>
      <h2><%= t('landing.planosTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.planosTexto') %></p>
    </div>

    <div class="planos">
      <% plans.forEach(function (plan, i) { %>
        <div class="plano <%= i === 1 ? 'destaque' : '' %>">
          <div class="marcador"><%= i === 1 ? t('landing.maisEscolhido') : '' %></div>
          <h3><%= plan.name %></h3>
          <div class="preco">
            R$ <%= (plan.price_cents / 100).toFixed(2).replace('.', ',') %><span><%= t('landing.porMes') %></span>
          </div>
          <ul>
            <li><strong><%= t('landing.minutosPorSemana', { n: plan.weekly_minutes_normal }) %></strong> <%= t('landing.minutosPorSemanaResto') %></li>
            <li class="bonus"><strong><%= t('landing.minutosBonus', { n: plan.weekly_minutes_bonus }) %></strong> <%= t('landing.minutosBonusResto') %></li>
            <li><%= plan.max_youtube_channels
                  ? t(plan.max_youtube_channels > 1 ? 'landing.canaisYoutube' : 'landing.canalYoutube', { n: plan.max_youtube_channels })
                  : t('landing.canaisIlimitados') %></li>
            <li><%= plan.max_tiktok_accounts
                  ? t(plan.max_tiktok_accounts > 1 ? 'landing.contasTiktok' : 'landing.contaTiktok', { n: plan.max_tiktok_accounts })
                  : t('landing.contasIlimitadas') %></li>
            <li><%= t('landing.incluiCorte') %></li>
            <li><%= t('landing.incluiDrive') %></li>
          </ul>
          <a class="btn <%= i === 1 ? 'btn-primary' : 'btn-ghost' %>" href="/register"><%= t('landing.comecar') %></a>
        </div>
      <% }); %>
    </div>

    <p style="text-align:center; color:var(--muted); font-size:0.9375rem; margin-top:2rem">
      <%= t('landing.notaPlanos') %>
    </p>
  </div>
</section>

<section class="secao" id="perguntas">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 2.5rem">
      <p class="eyebrow"><%= t('landing.faqOlho') %></p>
      <h2><%= t('landing.faqTitulo') %></h2>
    </div>

    <%#
      As perguntas vêm do controller, do mesmo array que gera o FAQPage nos
      dados estruturados. Escrever nos dois lugares garantiria que um dia iam
      divergir - e resposta diferente da que está na página é justamente o que
      faz o Google desconfiar do dado estruturado.
    %>
    <div class="faq">
      <% perguntas.forEach(function (item) { %>
        <details class="faq-item">
          <summary>
            <%= item.p %>
            <svg class="faq-seta" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <p><%= item.r %></p>
        </details>
      <% }); %>
    </div>

    <p class="faq-rodape">
      <%= t('landing.faqRodapeA') %>
      <a href="mailto:<%= contact.supportEmail %>"><%= contact.supportEmail %></a> —
      <%= t('landing.faqRodapeB') %> <%= contact.responseTime %>.
    </p>
  </div>
</section>

<section class="secao secao-final">
  <div class="wrap">
    <div class="final-caixa">
      <p class="eyebrow" style="color:rgba(255,255,255,.6)"><%= t('landing.finalOlho') %></p>
      <h2><%= t('landing.finalTitulo') %></h2>
      <p><%= t('landing.finalTexto') %></p>
      <div class="cta-linha" style="justify-content:center">
        <a class="btn btn-invertido btn-lg" href="/register"><%= t('nav.criarConta') %></a>
        <a class="btn btn-fantasma-claro btn-lg" href="/contato"><%= t('landing.falarComAGente') %></a>
      </div>
      <p class="final-nota"><%= t('landing.semFidelidade') %></p>
    </div>
  </div>
</section>

<%- include('../partials/public-footer') %>
