<%- include('../partials/public-header') %>

<%#
  Landing do Post Flow (reescrita em 12/10/2026).

  O que guia o desenho:
    - Tudo o que parece "tela do produto" aqui é DESENHO em HTML/CSS, não print.
      Print de painel envelhece no primeiro ajuste de botão e não traduz; o
      desenho acompanha o idioma e continua nítido em qualquer tela.
    - Movimento só onde ele explica alguma coisa (o corte saindo, a fila
      andando) e nunca para quem pediu menos movimento ao sistema
      (prefers-reduced-motion: tudo fica parado, no estado final).
    - Nada é carregado de fora do domínio (há teste) e nenhum script inline (o
      CSP bloquearia): o comportamento mora em /js/public.js.
    - Preço e limite de plano vêm do banco; nenhum número de plano é escrito
      à mão nesta página.
%>

<% if (typeof contaExcluida !== 'undefined' && contaExcluida) { %>
<div class="wrap">
  <p class="aviso-conta-excluida" role="status">Sua conta foi excluída. Os seus dados e cortes foram apagados e a assinatura foi cancelada.</p>
</div>
<% } %>

<%
  var reais = function (centavos) { return (centavos / 100).toFixed(2).replace('.', ','); };
%>

<!-- ============================================================ TOPO -->
<section class="lp-hero lp-escuro">
  <div class="lp-grade-fundo" aria-hidden="true"></div>
  <div class="lp-brilho lp-brilho-a" aria-hidden="true"></div>
  <div class="lp-brilho lp-brilho-b" aria-hidden="true"></div>

  <div class="wrap lp-hero-grade">
    <div class="lp-hero-texto">
      <a class="lp-selo" href="#redes">
        <span class="lp-selo-novo"><%= t('landing.seloNovo') %></span>
        <span><%= t('landing.seloTexto') %></span>
        <%- icone('arrow-right') %>
      </a>

      <h1>
        <span class="sr-only"><%= t('landing.h1Leitor') %></span>
        <span aria-hidden="true">
          <%= t('landing.h1a') %>
          <%# A rede no fim troca sozinha (public.js). Começa no TikTok, que é o
              texto que fica se o script não rodar. A preposição vai junto da
              rede, na mesma linha: sozinha no fim da linha de cima ela ficava
              solta ("no" pendurado). %>
          <span class="lp-linha-rede"><%= t('landing.h1Prep') %> <span class="lp-rotativo" data-rotativo="<%= t('landing.h1Redes').join('|') %>"><%= t('landing.h1Redes')[0] %></span></span>
        </span>
      </h1>

      <p class="lp-lead"><%= t('landing.lead') %> <strong><%= t('landing.leadForte') %></strong></p>

      <div class="lp-cta">
        <a class="btn lp-btn-luz btn-lg" href="/register"><%= t('landing.ctaPrincipal') %> <%- icone('arrow-right') %></a>
        <a class="btn lp-btn-vidro btn-lg" href="#como-funciona"><%- icone('player-play') %> <%= t('landing.verComoFunciona') %></a>
      </div>

      <ul class="lp-garantias">
        <% t('landing.garantias').forEach(function (g) { %>
          <li><%- icone('check') %><%= g %></li>
        <% }); %>
      </ul>
    </div>

    <%# Painel de demonstração: uma "linha de produção" em miniatura. É
        decorativo (aria-hidden) - tudo o que ele mostra está dito em texto na
        página. %>
    <div class="lp-painel" aria-hidden="true">
      <div class="lp-painel-topo">
        <span class="lp-painel-pontos"><i></i><i></i><i></i></span>
        <span class="lp-painel-titulo"><%- include('../partials/brand-mark') %> <%= t('landing.painelTitulo') %></span>
        <span class="lp-vivo"><i></i><%= t('landing.painelAoVivo') %></span>
      </div>

      <div class="lp-painel-corpo">
        <div class="lp-painel-fontes">
          <div class="lp-fonte">
            <span class="lp-fonte-ico" style="--cor:#ff0033"><%- icone('brand-youtube') %></span>
            <span class="lp-fonte-txt"><b><%= t('landing.painelFonteYoutube') %></b><small><%= t('landing.painelFonteYoutubeInfo') %></small></span>
          </div>
          <div class="lp-fonte">
            <span class="lp-fonte-ico" style="--cor:#9146ff"><%- icone('brand-twitch') %></span>
            <span class="lp-fonte-txt"><b><%= t('landing.painelFonteLive') %></b><small><i class="lp-rec"></i><%= t('landing.painelFonteLiveInfo') %></small></span>
          </div>
        </div>

        <div class="lp-fluxo" ><i></i></div>

        <div class="lp-ia">
          <span class="lp-ia-chip"><%- icone('sparkles') %> IA</span>
          <ol class="lp-ia-etapas">
            <% t('landing.painelEtapas').forEach(function (e, i) { %>
              <li class="<%= i < 2 ? 'feito' : 'agora' %>">
                <%- i < 2 ? icone('check') : '<span class="lp-girando"></span>' %>
                <span><%= e %></span>
                <% if (i === 2) { %><span class="lp-barra"><i></i></span><% } %>
              </li>
            <% }); %>
          </ol>
        </div>

        <div class="lp-fluxo"><i></i></div>

        <div class="lp-cortes">
          <div class="lp-corte lp-corte-1">
            <img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900" loading="eager">
            <span class="lp-corte-nota">94 <small><%= t('landing.painelNota') %></small></span>
          </div>
          <div class="lp-corte lp-corte-2">
            <span class="lp-corte-cam"><img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900"></span>
            <span class="lp-corte-jogo"></span>
            <span class="lp-corte-legenda"><%= t('landing.painelLegenda') %></span>
            <span class="lp-corte-nota">88 <small><%= t('landing.painelNota') %></small></span>
          </div>
          <div class="lp-corte lp-corte-3">
            <img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900">
            <span class="lp-corte-legenda lp-amarela"><%= t('landing.painelLegenda') %></span>
            <span class="lp-corte-nota">91 <small><%= t('landing.painelNota') %></small></span>
          </div>
        </div>
      </div>

      <%# Uma etiqueta por rede de destino: o ícone diz a rede (o nome vai no
          title, pra quem passa o mouse), o texto diz a situação do corte. %>
      <div class="lp-painel-saida">
        <span class="lp-saida" style="--cor:#111" title="TikTok"><%- icone('brand-tiktok') %><em class="ok"><%- icone('check') %><%= t('landing.painelPublicado') %></em></span>
        <span class="lp-saida" style="--cor:#dd2a7b" title="Instagram"><%- icone('brand-instagram') %><em><%= t('landing.painelPublica', { hora: '18:00' }) %></em></span>
        <span class="lp-saida" style="--cor:#1877f2" title="Facebook"><%- icone('brand-facebook') %><em><%= t('landing.painelPublica', { hora: '20:00' }) %></em></span>
      </div>
    </div>
  </div>

  <%# Fatos do produto (não estatística de uso): o que ele faz, em números. %>
  <div class="wrap">
    <dl class="lp-fatos">
      <% t('landing.fatos').forEach(function (f) { %>
        <div class="lp-fato"><dt><%= f.v %></dt><dd><%= f.r %></dd></div>
      <% }); %>
    </dl>
  </div>
</section>

<!-- ============================================================ REDES -->
<section class="secao lp-secao" id="redes">
  <div class="wrap">
    <div class="lp-cabeca lp-centro" data-revelar>
      <p class="eyebrow"><%= t('landing.redesOlho') %></p>
      <h2><%= t('landing.redesTitulo') %></h2>
      <p class="lp-sub"><%= t('landing.redesTexto') %></p>
    </div>

    <div class="lp-hub" data-revelar>
      <div class="lp-hub-col">
        <p class="lp-hub-rotulo"><%= t('landing.fontesRotulo') %></p>
        <ul class="lp-hub-fontes">
          <% t('landing.fontes').forEach(function (f, i) { var fonte = fontes[i]; %>
            <li class="lp-no">
              <span class="lp-no-ico" style="--cor:<%= fonte.cor %>"><%- icone(fonte.icone) %></span>
              <span><b><%= f.h %></b><small><%= f.p %></small></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <div class="lp-hub-centro">
        <div class="lp-nucleo">
          <span class="lp-orbita" aria-hidden="true"></span>
          <span class="lp-orbita lp-orbita-2" aria-hidden="true"></span>
          <span class="lp-nucleo-marca"><%- include('../partials/brand-mark') %></span>
          <span class="lp-nucleo-nome">Post Flow</span>
        </div>
      </div>

      <div class="lp-hub-col">
        <p class="lp-hub-rotulo"><%= t('landing.destinosRotulo') %></p>
        <ul class="lp-hub-redes">
          <% redes.forEach(function (r) { %>
            <li class="lp-rede">
              <span class="lp-rede-ico" style="--fundo:<%= r.fundo %>"><%- icone(r.icone) %></span>
              <span><%= r.nome %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ COMO FUNCIONA -->
<section class="secao lp-secao lp-nevoa" id="como-funciona">
  <div class="wrap">
    <div class="lp-cabeca" data-revelar>
      <p class="eyebrow"><%= t('nav.comoFunciona') %></p>
      <h2><%= t('landing.comoFuncionaTitulo') %></h2>
      <p class="lp-sub"><%= t('landing.comoFuncionaTexto') %></p>
    </div>

    <ol class="lp-passos">
      <% t('landing.passos').forEach(function (passo, i) { %>
        <li class="lp-passo" data-revelar style="--atraso:<%= i * 90 %>ms">
          <div class="lp-passo-topo">
            <span class="lp-passo-num"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="lp-passo-quem <%= i === 0 ? '' : 'maquina' %>"><%= i === 0 ? t('landing.passoVoce') : t('landing.passoMaquina') %></span>
          </div>
          <span class="lp-passo-ico"><%- icone(['cloud-upload', 'brain', 'rocket'][i]) %></span>
          <h3><%= passo.h %></h3>
          <p><%= passo.p %></p>
        </li>
      <% }); %>
    </ol>
  </div>
</section>

<!-- ============================================================ LINHA DE PRODUÇÃO -->
<section class="secao lp-escuro lp-linha" id="linha">
  <div class="lp-grade-fundo" aria-hidden="true"></div>
  <div class="wrap">
    <div class="lp-cabeca lp-centro" data-revelar>
      <p class="eyebrow"><%= t('landing.linhaOlho') %></p>
      <h2><%= t('landing.linhaTitulo') %></h2>
      <p class="lp-sub"><%= t('landing.linhaTexto') %></p>
    </div>

    <ol class="lp-etapas" data-revelar>
      <% t('landing.linhaEtapas').forEach(function (e, i) { %>
        <li class="lp-etapa" style="--i:<%= i %>">
          <span class="lp-etapa-no"><%- icone(['broadcast', 'cloud-upload', 'subtitles-ai', 'sparkles', 'scissors', 'calendar-time'][i]) %></span>
          <b><%= e.h %></b>
          <small><%= e.p %></small>
        </li>
      <% }); %>
    </ol>
  </div>
</section>

<!-- ============================================================ RECURSOS -->
<section class="secao lp-secao" id="recursos">
  <div class="wrap">
    <div class="lp-cabeca" data-revelar>
      <p class="eyebrow"><%= t('landing.recursosOlho') %></p>
      <h2><%= t('landing.recursosTitulo') %></h2>
      <p class="lp-sub"><%= t('landing.recursosTexto') %></p>
    </div>

    <% var rec = t('landing.recursos'); %>
    <div class="lp-bento">
      <%# 1. Lives: linha do tempo da transmissão com os cortes marcados. %>
      <article class="lp-cartao lp-c-largo" data-revelar>
        <div class="lp-cartao-arte lp-arte-live" aria-hidden="true">
          <div class="lp-live-topo">
            <span class="lp-live-selo"><i></i><%= t('landing.recursosAoVivo') %></span>
            <span class="lp-live-plat"><%- icone('brand-twitch') %><%- icone('brand-kick') %></span>
          </div>
          <div class="lp-live-trilha">
            <span class="lp-live-onda"></span>
            <span class="lp-live-marca" style="--x:18%"></span>
            <span class="lp-live-marca" style="--x:41%"></span>
            <span class="lp-live-marca" style="--x:63%"></span>
            <span class="lp-live-agora"></span>
          </div>
          <span class="lp-live-botao"><%- icone('scissors') %><%= t('landing.recursosClipar') %></span>
        </div>
        <h3><%= rec[0].h %></h3>
        <p><%= rec[0].p %></p>
      </article>

      <%# 2. Redes: grade de ícones, cada um com a cor da rede. %>
      <article class="lp-cartao lp-c-largo" data-revelar style="--atraso:80ms">
        <div class="lp-cartao-arte lp-arte-redes" aria-hidden="true">
          <% redes.forEach(function (r, i) { %>
            <span class="lp-arte-rede" style="--fundo:<%= r.fundo %>;--i:<%= i %>"><%- icone(r.icone) %></span>
          <% }); %>
        </div>
        <h3><%= rec[1].h %></h3>
        <p><%= rec[1].p %></p>
      </article>

      <%# 3. IA: barras de nota de cada trecho. %>
      <article class="lp-cartao" data-revelar>
        <div class="lp-cartao-arte lp-arte-notas" aria-hidden="true">
          <% [[38, 52], [94, 0], [61, 0], [88, 0], [45, 0]].forEach(function (n, i) { %>
            <span class="lp-nota-barra <%= n[0] > 80 ? 'alta' : '' %>" style="--h:<%= n[0] %>%;--i:<%= i %>"><% if (n[0] > 80) { %><b><%= n[0] %></b><% } %></span>
          <% }); %>
        </div>
        <h3><%= rec[2].h %></h3>
        <p><%= rec[2].p %></p>
      </article>

      <%# 4. Estilo: três legendas em estilos diferentes. %>
      <article class="lp-cartao" data-revelar style="--atraso:80ms">
        <div class="lp-cartao-arte lp-arte-estilos" aria-hidden="true">
          <span class="lp-est lp-est-1"><%= t('landing.recursosTituloExemplo') %></span>
          <span class="lp-est lp-est-2"><%= t('landing.recursosLegendaExemplo') %></span>
          <span class="lp-est lp-est-3"><%= t('landing.recursosLegendaExemplo') %></span>
        </div>
        <h3><%= rec[3].h %></h3>
        <p><%= rec[3].p %></p>
      </article>

      <%# 5. Webcam: o corte de live montado (câmera em cima, jogo embaixo). %>
      <article class="lp-cartao" data-revelar style="--atraso:160ms">
        <div class="lp-cartao-arte lp-arte-camera" aria-hidden="true">
          <span class="lp-fone">
            <span class="lp-fone-cam"><img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900" loading="lazy"></span>
            <span class="lp-fone-jogo"></span>
          </span>
          <span class="lp-camera-seta"><%- icone('sparkles') %></span>
        </div>
        <h3><%= rec[4].h %></h3>
        <p><%= rec[4].p %></p>
      </article>

      <%# 6. Fila: os horários do dia com o corte que sai em cada um. %>
      <article class="lp-cartao" data-revelar>
        <div class="lp-cartao-arte lp-arte-fila" aria-hidden="true">
          <% ['08:00', '12:00', '16:00', '20:00'].forEach(function (h, i) { %>
            <span class="lp-fila-item <%= i === 1 ? 'agora' : '' %>" style="--i:<%= i %>">
              <span class="lp-fila-hora"><%= h %></span>
              <span class="lp-fila-mini"><img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900" loading="lazy"></span>
              <span class="lp-fila-linhas"><i></i><i></i></span>
            </span>
          <% }); %>
        </div>
        <h3><%= rec[5].h %></h3>
        <p><%= rec[5].p %></p>
      </article>

      <%# 7. Dublagem: a trilha de áudio escolhida. %>
      <article class="lp-cartao" data-revelar style="--atraso:80ms">
        <div class="lp-cartao-arte lp-arte-audio" aria-hidden="true">
          <span class="lp-audio-onda"><% for (var k = 0; k < 22; k++) { %><i style="--k:<%= k %>"></i><% } %></span>
          <span class="lp-audio-chip"><%- icone('language') %><%= t('landing.recursosDublagem') %></span>
        </div>
        <h3><%= rec[6].h %></h3>
        <p><%= rec[6].p %></p>
      </article>

      <%# 8. Flora: uma resposta da assistente. %>
      <article class="lp-cartao" data-revelar style="--atraso:160ms">
        <div class="lp-cartao-arte lp-arte-flora" aria-hidden="true">
          <span class="lp-flora-avatar"><%- icone('sparkles') %></span>
          <span class="lp-flora-balao"><%= t('landing.recursosFlora') %></span>
        </div>
        <h3><%= rec[7].h %></h3>
        <p><%= rec[7].p %></p>
      </article>
    </div>

    <div class="lp-extras" data-revelar>
      <p class="lp-extras-titulo"><%= t('landing.extrasTitulo') %></p>
      <ul>
        <% t('landing.extras').forEach(function (e) { %>
          <li><%- icone('check') %><%= e %></li>
        <% }); %>
      </ul>
    </div>
  </div>
</section>

<!-- ============================================================ PARA QUEM -->
<section class="secao lp-secao lp-nevoa">
  <div class="wrap">
    <div class="lp-cabeca lp-centro" data-revelar>
      <p class="eyebrow"><%= t('landing.paraQuemOlho') %></p>
      <h2><%= t('landing.paraQuemTitulo') %></h2>
    </div>
    <ul class="lp-perfis">
      <% t('landing.paraQuem').forEach(function (p, i) { %>
        <li class="lp-perfil" data-revelar style="--atraso:<%= i * 70 %>ms">
          <span class="lp-perfil-ico"><%- icone(['brand-youtube', 'microphone', 'broadcast', 'briefcase'][i]) %></span>
          <h3><%= p.h %></h3>
          <p><%= p.p %></p>
        </li>
      <% }); %>
    </ul>
  </div>
</section>

<!-- ============================================================ ANTES E DEPOIS -->
<section class="secao lp-secao">
  <div class="wrap">
    <div class="lp-cabeca lp-centro" data-revelar>
      <p class="eyebrow"><%= t('landing.antesOlho') %></p>
      <h2><%= t('landing.antesTitulo') %></h2>
    </div>
    <div class="lp-comparar" data-revelar>
      <div class="lp-comp lp-comp-sem">
        <p class="lp-comp-titulo"><%= t('landing.antesSem') %></p>
        <ul>
          <% t('landing.antes').forEach(function (a) { %><li><%- icone('x') %><%= a %></li><% }); %>
        </ul>
      </div>
      <div class="lp-comp lp-comp-com">
        <p class="lp-comp-titulo"><%- include('../partials/brand-mark') %> <%= t('landing.antesCom') %></p>
        <ul>
          <% t('landing.depois').forEach(function (d) { %><li><%- icone('check') %><%= d %></li><% }); %>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ FEED DE CORTES -->
<section class="secao lp-escuro lp-feed" id="feed">
  <div class="lp-grade-fundo" aria-hidden="true"></div>
  <div class="lp-brilho lp-brilho-d" aria-hidden="true"></div>
  <div class="wrap lp-feed-grade">
    <div class="lp-feed-texto" data-revelar>
      <p class="eyebrow"><%= t('landing.feedOlho') %></p>
      <h2><%= t('landing.feedTitulo') %></h2>
      <p class="lp-sub"><%= t('landing.feedTexto') %></p>
      <ul class="lp-feed-pontos">
        <% t('landing.feedPontos').forEach(function (f, i) { %>
          <li>
            <span class="lp-feed-ponto-ico"><%- icone(['layout-board-split', 'rocket', 'refresh'][i]) %></span>
            <span><b><%= f.h %></b><%= f.p %></span>
          </li>
        <% }); %>
      </ul>
      <a class="btn lp-btn-luz btn-lg" href="/register"><%= t('landing.feedCta') %> <%- icone('arrow-right') %></a>
    </div>

    <%# Desenho do feed: o celular rola de um corte para o outro sozinho, e o
        painel "Postar em" mostra o que acontece com um toque. Decorativo -
        tudo o que ele mostra está dito no texto ao lado. %>
    <div class="lp-feed-palco" aria-hidden="true" data-revelar style="--atraso:120ms">
      <div class="lp-cel">
        <div class="lp-cel-tela">
          <div class="lp-cel-trilho">
            <div class="lp-cel-quadro">
              <img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900" loading="lazy">
            </div>
            <div class="lp-cel-quadro lp-cel-live">
              <span class="lp-cel-cam"><img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900" loading="lazy"></span>
              <span class="lp-cel-jogo"></span>
              <span class="lp-cel-legenda"><%= t('landing.recursosLegendaExemplo') %></span>
            </div>
            <div class="lp-cel-quadro lp-cel-zoom">
              <img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900" loading="lazy">
              <span class="lp-cel-legenda lp-amarela"><%= t('landing.painelLegenda') %></span>
            </div>
            <%# Repete o primeiro, para a volta do loop não dar um pulo. %>
            <div class="lp-cel-quadro">
              <img src="/img/produto/corte-exemplo.jpg" alt="" width="506" height="900" loading="lazy">
            </div>
          </div>
          <div class="lp-cel-topo"><span>3 / 34</span></div>
          <div class="lp-cel-lado">
            <span class="lp-cel-acao lp-cel-curtir"><%- icone('heart') %></span>
            <span class="lp-cel-acao lp-cel-postar"><%- icone('rocket') %></span>
          </div>
          <div class="lp-cel-rodape"><%= t('landing.feedLegenda') %></div>
        </div>
      </div>

      <div class="lp-postar">
        <p class="lp-postar-titulo"><%= t('landing.feedPostarEm') %></p>
        <ul>
          <% [redes[0], redes[1], redes[2], redes[3]].forEach(function (r, i) { %>
            <li class="<%= i < 3 ? 'marcada' : '' %>">
              <span class="lp-rede-ico" style="--fundo:<%= r.fundo %>"><%- icone(r.icone) %></span>
              <span class="lp-postar-nome"><%= r.nome %></span>
              <span class="lp-postar-caixa"><%- icone('check') %></span>
            </li>
          <% }); %>
        </ul>
        <span class="lp-postar-botao"><%= t('landing.feedNaFila') %></span>
        <span class="lp-postar-quando"><%- icone('clock') %><%= t('landing.feedProximo') %></span>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ PLANOS -->
<section class="secao lp-secao lp-nevoa" id="planos">
  <div class="wrap">
    <div class="lp-cabeca lp-centro" data-revelar>
      <p class="eyebrow"><%= t('landing.planosOlho') %></p>
      <h2><%= t('landing.planosTitulo') %></h2>
      <p class="lp-sub"><%= mostrarTunel ? t('landing.planosTexto') : t('landing.planosTextoSemTunel') %></p>
      <p class="lp-regra"><%- icone('bolt') %><%= t('landing.regraCreditos') %></p>
    </div>

    <div class="planos">
      <% plans.forEach(function (plan, i) { %>
        <div class="plano <%= i === 1 ? 'destaque' : '' %>" data-revelar style="--atraso:<%= i * 80 %>ms">
          <% if (i === 1) { %><div class="marcador"><%= t('landing.maisEscolhido') %></div><% } %>
          <h3><%= plan.name %></h3>
          <%#
            Os DOIS degraus do preco, sempre juntos. Anunciar so o promocional e
            deixar o valor cheio pra fatura do mes seguinte e o tipo de coisa
            que gera estorno - e, num site publico, reclamacao no Reclame Aqui.
          %>
          <% if (plan.first_month_price_cents && plan.first_month_price_cents < plan.price_cents) { %>
            <div class="preco">
              R$ <%= reais(plan.first_month_price_cents) %><span><%= t('landing.noPrimeiroMes') %></span>
            </div>
            <p class="preco-depois">
              <%= t('landing.depoisPorMes', { valor: reais(plan.price_cents) }) %>
              ·
              <strong><%= t('landing.descontoPrimeiroMes', { n: Math.round((1 - plan.first_month_price_cents / plan.price_cents) * 100) }) %></strong>
            </p>
          <% } else { %>
            <div class="preco">
              R$ <%= reais(plan.price_cents) %><span><%= t('landing.porMes') %></span>
            </div>
          <% } %>
          <%# O plano viaja junto: quem clica aqui ja escolheu, e depois de
              criar a conta cai direto no checkout desse plano (o valor fica na
              sessao, ver affiliateAttribution + destinoDepoisDeEntrar). %>
          <a class="btn <%= i === 1 ? 'btn-primary' : 'btn-ghost' %>"
             href="/register?plano=<%= encodeURIComponent(plan.key) %>"><%= t('landing.comecar') %></a>
          <ul>
            <li>
              <span class="icone"><%- icone('clock') %></span>
              <span><strong><%= t('landing.minutosPorSemana', { n: plan.weekly_minutes_normal }) %></strong> <%= t('landing.minutosPorSemanaResto') %></span>
            </li>
<% if (mostrarTunel) { %>
            <li class="bonus">
              <span class="icone"><%- icone('bolt') %></span>
              <span><strong><%= t('landing.minutosBonus', { n: plan.weekly_minutes_bonus }) %></strong> <%= t('landing.minutosBonusResto') %></span>
            </li>
            <% } %>
            <li>
              <span class="icone"><%- icone('brand-youtube') %></span>
              <span><%= plan.max_youtube_channels
                    ? t(plan.max_youtube_channels > 1 ? 'landing.canaisYoutube' : 'landing.canalYoutube', { n: plan.max_youtube_channels })
                    : t('landing.canaisIlimitados') %></span>
            </li>
            <li>
              <span class="icone"><%- icone('brand-tiktok') %></span>
              <span><%= plan.max_tiktok_accounts
                    ? t(plan.max_tiktok_accounts > 1 ? 'landing.contasTiktok' : 'landing.contaTiktok', { n: plan.max_tiktok_accounts })
                    : t('landing.contasIlimitadas') %></span>
            </li>
            <% if (plan.max_contas_por_rede) { %>
            <li>
              <span class="icone"><%- icone('stack-2') %></span>
              <span><%= t(plan.max_contas_por_rede > 1 ? 'landing.contasPorRede' : 'landing.contaPorRede', { n: plan.max_contas_por_rede }) %></span>
            </li>
            <% } %>
            <% if (plan.max_canais_de_live) { %>
            <li>
              <span class="icone"><%- icone('broadcast') %></span>
              <span><%= t(plan.max_canais_de_live > 1 ? 'landing.canaisLive' : 'landing.canalLive', { n: plan.max_canais_de_live }) %></span>
            </li>
            <% } %>
            <li>
              <span class="icone"><%- icone('wand') %></span>
              <span><%= t('landing.incluiCorte') %></span>
            </li>
            <li>
              <span class="icone"><%- icone('layout-board-split') %></span>
              <span><%= t('landing.incluiDrive') %></span>
            </li>
            <% if (plan.extra_rede_price_cents) { %>
            <li class="extra">
              <span class="icone"><%- icone('stack-2') %></span>
              <span><%= t('landing.contaExtraRede', { valor: reais(plan.extra_rede_price_cents) }) %></span>
            </li>
            <% } %>
            <% if (plan.extra_channel_price_cents) { %>
            <li class="extra">
              <span class="icone"><%- icone('brand-youtube') %></span>
              <span><%= t('landing.conexoesExtras', { canal: reais(plan.extra_channel_price_cents) }) %></span>
            </li>
            <% } %>
          </ul>
        </div>
      <% }); %>
    </div>

    <p class="lp-nota-planos"><%= t('landing.notaPlanos') %></p>
  </div>
</section>

<!-- ============================================================ CONFIANÇA -->
<section class="secao lp-secao lp-confianca">
  <div class="wrap">
    <div class="lp-cabeca lp-centro" data-revelar>
      <p class="eyebrow"><%= t('landing.confiancaOlho') %></p>
      <h2><%= t('landing.confiancaTitulo') %></h2>
    </div>
    <ul class="lp-selos">
      <% t('landing.confianca').forEach(function (c, i) { %>
        <li data-revelar style="--atraso:<%= i * 70 %>ms">
          <span class="lp-selo-ico"><%- icone(['building-bank', 'credit-card', 'lock', 'refresh'][i]) %></span>
          <h3><%= c.h %></h3>
          <p><%= c.p %></p>
        </li>
      <% }); %>
    </ul>
  </div>
</section>

<!-- ============================================================ PERGUNTAS -->
<section class="secao lp-secao lp-nevoa" id="perguntas">
  <div class="wrap lp-faq-grade">
    <div class="lp-faq-cabeca">
      <p class="eyebrow"><%= t('landing.faqOlho') %></p>
      <h2><%= t('landing.faqTitulo') %></h2>
      <p class="faq-rodape">
        <%= t('landing.faqRodapeA') %>
        <a href="mailto:<%= contact.supportEmail %>"><%= contact.supportEmail %></a> —
        <%= t('landing.faqRodapeB') %> <%= contact.responseTime %>.
      </p>
    </div>

    <%#
      As perguntas vêm do controller, do mesmo array que gera o FAQPage nos
      dados estruturados. Escrever nos dois lugares garantiria que um dia iam
      divergir - e resposta diferente da que está na página é justamente o que
      faz o Google desconfiar do dado estruturado.
    %>
    <div class="faq">
      <% perguntas.forEach(function (item) { %>
        <details class="faq-item">
          <summary>
            <%= item.p %>
            <svg class="faq-seta" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <p><%= item.r %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============================================================ FINAL -->
<section class="secao lp-escuro lp-final">
  <div class="lp-grade-fundo" aria-hidden="true"></div>
  <div class="lp-brilho lp-brilho-c" aria-hidden="true"></div>
  <div class="wrap lp-centro" data-revelar>
    <p class="eyebrow"><%= t('landing.finalOlho') %></p>
    <h2><%= t('landing.finalTitulo') %></h2>
    <p class="lp-sub"><%= t('landing.finalTexto') %></p>
    <div class="lp-cta lp-cta-centro">
      <a class="btn lp-btn-luz btn-lg" href="/register"><%= t('landing.ctaPrincipal') %> <%- icone('arrow-right') %></a>
      <a class="btn lp-btn-vidro btn-lg" href="/contato"><%= t('landing.falarComAGente') %></a>
    </div>
    <p class="lp-final-nota"><%= t('landing.semFidelidade') %></p>
  </div>
</section>

<%- include('../partials/public-footer') %>
