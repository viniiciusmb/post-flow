<%- include('../partials/public-header') %>

<section class="hero">
  <div class="wrap">
    <p class="selo-hero">
      <%- include('../partials/logo-youtube') %>
      YouTube
      <span class="selo-seta" aria-hidden="true">→</span>
      <%- include('../partials/logo-tiktok') %>
      TikTok
      <span class="selo-texto"><%= t('landing.selo') %></span>
    </p>

    <h1><%= t('landing.h1a') %><br><%= t('landing.h1b') %> <em><%= t('landing.h1c') %></em>.</h1>
    <p class="lead">
      <%= t('landing.lead') %> <strong><%= t('landing.leadForte') %></strong>
    </p>
    <div class="cta-linha">
      <a class="btn btn-primary btn-lg" href="/register"><%= t('nav.criarConta') %></a>
      <a class="btn btn-ghost btn-lg" href="#como-funciona"><%= t('landing.verComoFunciona') %></a>
    </div>
    <p class="nota"><%= t('landing.notaHero') %></p>

    <%# Video mudo em loop com prints REAIS da plataforma (canal sendo
        adicionado, estilo de corte, TikTok conectado) - substituiu o duo
        macbook+iphone estático: explica em segundos o que antes exigia ler os
        cartões de "como funciona" mais abaixo. Só em português (mesma
        limitação já aceita no video de fluxo da seção seguinte - re-gravar
        por idioma é trabalho grande pra um ganho pequeno). Gerado com
        Remotion, fonte em /marketing-video. %>
    <video
      class="hero-video"
      src="/video/tutorial-passo-a-passo.mp4"
      poster="/video/tutorial-passo-a-passo-poster.jpg"
      width="1620" height="1000"
      autoplay muted loop playsinline preload="auto" fetchpriority="high"
      aria-label="<%= t('landing.tutorialVideoAlt') %>"
    ></video>
  </div>
</section>

<section class="secao" id="como-funciona">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 3.5rem">
      <p class="eyebrow"><%= t('nav.comoFunciona') %></p>
      <h2><%= t('landing.comoFuncionaTitulo') %></h2>
    </div>

    <div class="passos">
      <% t('landing.passos').forEach(function (passo) { %>
        <div class="passo">
          <h3><%= passo.h %></h3>
          <p><%= passo.p %></p>
        </div>
      <% }); %>
    </div>

    <%# Video mudo, em loop, sem controles - pensado pra parecer parte da
        propria pagina (nao um player incorporado). Mostra exatamente o que o
        titulo desta secao ja diz em texto ("voce participa da primeira
        etapa"): vídeo novo no YouTube, o Post Flow cortando em clipes
        verticais, publicação automática no TikTok. Gerado com Remotion,
        fonte em /marketing-video (fora do build do site - so o .mp4
        renderizado entra aqui).

        data-lazy-src (nao src) + sem autoplay: fica abaixo da dobra, entao so
        baixa quando chega perto da tela (ver o IntersectionObserver em
        public.js) - assim ele nao disputa banda com o video da hero logo na
        abertura da pagina.

        No celular o video nao encolhe pra largura da tela (o texto por
        dentro dele viraria ilegivel) - fica num tamanho fixo legivel dentro
        de um contêiner com rolagem horizontal PROPRIA (a pagina em si nunca
        rola de lado, ver overflow-x:hidden no <html>). %>
    <div class="fluxo-video-envolt">
      <video
        class="fluxo-video"
        data-lazy-src="/video/fluxo-automatico.mp4"
        poster="/video/fluxo-automatico-poster.jpg"
        width="1550" height="730"
        muted loop playsinline tabindex="0"
        aria-label="<%= t('landing.fluxoVideoAlt') %>"
      ></video>
    </div>
    <p class="fluxo-dica"><%= t('landing.fluxoDica') %></p>

    <div class="narrow" style="margin: clamp(3rem, 6vw, 4.5rem) auto 0; text-align: center">
      <p class="eyebrow"><%= t('landing.telasOlho') %></p>
      <h2><%= t('landing.telasTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.telasTexto') %></p>
    </div>

    <div class="duo">
      <div class="macbook">
        <div class="macbook-tampa">
          <div class="macbook-tela">
            <img
              <%# Mesmo print da hero antiga - o arquivo continua sendo
                  gerado a partir do próprio painel, por idioma. %>
              src="/img/produto/cortes-light<%= lang === 'pt' ? '' : '-' + lang %>.png"
              alt="<%= t('landing.altComputador') %>"
              width="2880" height="1800" loading="lazy">
          </div>
        </div>
        <div class="macbook-base"></div>
      </div>

      <div class="iphone">
        <div class="iphone-tela">
          <img
            src="/img/produto/cortes-mobile<%= lang === 'pt' ? '' : '-' + lang %>.png"
            alt="<%= t('landing.altCelular') %>"
            width="1170" height="2532" loading="lazy">
        </div>
      </div>
    </div>
  </div>
</section>

<section class="secao secao-mist">
  <div class="wrap whats-grid">
    <div class="whats-texto">
      <p class="eyebrow"><%= t('landing.whatsOlho') %></p>
      <h2><%= t('landing.whatsTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.whatsTexto') %></p>
    </div>
    <div class="whats-banner">
      <%- include('../partials/whatsapp-banner') %>
    </div>
  </div>
</section>

<section class="secao secao-mist" id="recursos">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 3rem">
      <p class="eyebrow"><%= t('landing.recursosOlho') %></p>
      <h2><%= t('landing.recursosTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.recursosTexto') %></p>
    </div>

    <%# Carrossel, não grade: 9 caixas de texto puro empilhadas viravam uma
        parede ilegível no celular. Cada cartão ganhou um ícone desenhado à
        mão (mesmo estilo dos ícones de marca do cabeçalho) pra dar um ponto
        de referência visual rápido antes do texto. Rola por toque/mouse/
        trackpad + as setas (JS em public.js: recursos-carrossel). %>
    <% var recursosIcones = [
      // Estilo visual do corte: moldura com legenda
      '<rect x="6" y="3" width="12" height="18" rx="2.2"/><path d="M8.4 15.6h7.2" stroke-linecap="round"/>',
      // Enquadramento na mão: cantos de crop
      '<path d="M4 9V4.6h4.4M20 9V4.6h-4.4M4 15v4.4h4.4M20 15v4.4h-4.4"/>',
      // Imagem de fundo: foto com montanha
      '<rect x="3" y="4.5" width="18" height="15" rx="2"/><circle cx="8.4" cy="9.6" r="1.4"/><path d="M21 15.5l-5.4-5.2L9.2 17"/>',
      // Numeração de série: cerquilha (Parte 1, Parte 2...)
      '<path d="M9.5 4L7 20M17 4l-2.5 16M4 9h16M3.3 15h16"/>',
      // Configuração por canal: sliders
      '<path d="M4 6.5h9M17.5 6.5H20M4 12h2.5M11 12H20M4 17.5h11.5M19 17.5H20"/><circle cx="13" cy="6.5" r="1.9"/><circle cx="8.5" cy="12" r="1.9"/><circle cx="17.5" cy="17.5" r="1.9"/>',
      // Descrição automática: linhas de texto com estrela de IA
      '<path d="M3.5 6.5h11M3.5 12h11M3.5 17.5h7"/><path d="M19 4.2l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9z"/>',
      // Um canal, várias contas: camadas
      '<path d="M12 3.3l8.4 4.5-8.4 4.5-8.4-4.5z"/><path d="M3.6 12.4l8.4 4.5 8.4-4.5"/><path d="M3.6 16.9l8.4 4.5 8.4-4.5"/>',
      // Horários que você escolhe: relógio
      '<circle cx="12" cy="12" r="8.6"/><path d="M12 7.2V12l3.4 2"/>',
      // Cópia no Google Drive: seta baixando pra bandeja
      '<path d="M12 3.5v10.4M12 13.9l-3.6-3.6M12 13.9l3.6-3.6"/><path d="M4.2 15.5v3a2 2 0 002 2h11.6a2 2 0 002-2v-3"/>',
    ]; %>
    <div class="recursos-carrossel-envolt">
      <button type="button" class="recursos-seta recursos-seta-esq" data-direcao="-1" aria-label="<%= t('landing.recursosAnterior') %>">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="recursos-carrossel" id="recursos-carrossel" tabindex="0" role="region" aria-label="<%= t('landing.recursosOlho') %>">
        <% t('landing.recursos').forEach(function (r, i) { %>
          <article class="recurso-card">
            <span class="recurso-icone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- recursosIcones[i] %></svg>
            </span>
            <span class="recurso-indice"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= r.h %></h3>
            <p><%= r.p %></p>
          </article>
        <% }); %>
      </div>
      <button type="button" class="recursos-seta recursos-seta-dir" data-direcao="1" aria-label="<%= t('landing.recursosProximo') %>">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="recursos-pontos" id="recursos-pontos" aria-hidden="true">
      <% t('landing.recursos').forEach(function (_, i) { %>
        <span class="recursos-ponto" data-indice="<%= i %>"></span>
      <% }); %>
    </div>
  </div>
</section>

<section class="secao secao-mist" id="planos">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 3rem">
      <p class="eyebrow"><%= t('landing.planosOlho') %></p>
      <h2><%= t('landing.planosTitulo') %></h2>
      <p style="color: var(--muted)"><%= t('landing.planosTexto') %></p>
    </div>

    <div class="planos">
      <% plans.forEach(function (plan, i) { %>
        <div class="plano <%= i === 1 ? 'destaque' : '' %>">
          <div class="marcador"><%= i === 1 ? t('landing.maisEscolhido') : '' %></div>
          <h3><%= plan.name %></h3>
          <div class="preco">
            R$ <%= (plan.price_cents / 100).toFixed(2).replace('.', ',') %><span><%= t('landing.porMes') %></span>
          </div>
          <ul>
            <li><strong><%= t('landing.minutosPorSemana', { n: plan.weekly_minutes_normal }) %></strong> <%= t('landing.minutosPorSemanaResto') %></li>
            <li class="bonus"><strong><%= t('landing.minutosBonus', { n: plan.weekly_minutes_bonus }) %></strong> <%= t('landing.minutosBonusResto') %></li>
            <li><%= plan.max_youtube_channels
                  ? t(plan.max_youtube_channels > 1 ? 'landing.canaisYoutube' : 'landing.canalYoutube', { n: plan.max_youtube_channels })
                  : t('landing.canaisIlimitados') %></li>
            <li><%= plan.max_tiktok_accounts
                  ? t(plan.max_tiktok_accounts > 1 ? 'landing.contasTiktok' : 'landing.contaTiktok', { n: plan.max_tiktok_accounts })
                  : t('landing.contasIlimitadas') %></li>
            <li><%= t('landing.incluiCorte') %></li>
            <li><%= t('landing.incluiDrive') %></li>
          </ul>
          <a class="btn <%= i === 1 ? 'btn-primary' : 'btn-ghost' %>" href="/register"><%= t('landing.comecar') %></a>
        </div>
      <% }); %>
    </div>

    <p style="text-align:center; color:var(--muted); font-size:0.9375rem; margin-top:2rem">
      <%= t('landing.notaPlanos') %>
    </p>
  </div>
</section>

<section class="secao" id="perguntas">
  <div class="wrap">
    <div class="narrow" style="margin-bottom: 2.5rem">
      <p class="eyebrow"><%= t('landing.faqOlho') %></p>
      <h2><%= t('landing.faqTitulo') %></h2>
    </div>

    <%#
      As perguntas vêm do controller, do mesmo array que gera o FAQPage nos
      dados estruturados. Escrever nos dois lugares garantiria que um dia iam
      divergir - e resposta diferente da que está na página é justamente o que
      faz o Google desconfiar do dado estruturado.
    %>
    <div class="faq">
      <% perguntas.forEach(function (item) { %>
        <details class="faq-item">
          <summary>
            <%= item.p %>
            <svg class="faq-seta" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <p><%= item.r %></p>
        </details>
      <% }); %>
    </div>

    <p class="faq-rodape">
      <%= t('landing.faqRodapeA') %>
      <a href="mailto:<%= contact.supportEmail %>"><%= contact.supportEmail %></a> —
      <%= t('landing.faqRodapeB') %> <%= contact.responseTime %>.
    </p>
  </div>
</section>

<section class="secao secao-final">
  <div class="wrap">
    <div class="final-caixa">
      <p class="eyebrow" style="color:rgba(255,255,255,.6)"><%= t('landing.finalOlho') %></p>
      <h2><%= t('landing.finalTitulo') %></h2>
      <p><%= t('landing.finalTexto') %></p>
      <div class="cta-linha" style="justify-content:center">
        <a class="btn btn-invertido btn-lg" href="/register"><%= t('nav.criarConta') %></a>
        <a class="btn btn-fantasma-claro btn-lg" href="/contato"><%= t('landing.falarComAGente') %></a>
      </div>
      <p class="final-nota"><%= t('landing.semFidelidade') %></p>
    </div>
  </div>
</section>

<%- include('../partials/public-footer') %>
