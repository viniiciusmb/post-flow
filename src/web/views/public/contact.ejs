<%- include('../partials/public-header') %>

<div class="wrap">
  <article class="doc">
    <h1><%= t('contato.titulo') %></h1>
    <p class="atualizado"><%= t('contato.respondemos', { tempo: contact.responseTime }) %></p>

    <div class="destaque">
      <p>
        <strong><%= t('contato.emailRotulo') %>:</strong>
        <a href="mailto:<%= contact.supportEmail %>"><%= contact.supportEmail %></a>
      </p>
      <p><%= t('contato.mesmoCanal') %></p>
    </div>

    <h2><%= t('contato.jaTemContaTitulo') %></h2>
    <p><%- t('contato.jaTemContaTexto') %></p>
    <ul>
      <% t('contato.atalhos').forEach(function (item) { %>
        <li><%- item %></li>
      <% }); %>
    </ul>

    <h2><%= t('contato.exclusaoTitulo') %></h2>
    <p><%- t('contato.exclusaoTexto').replace(/\{email\}/g, contact.supportEmail) %></p>

    <h2><%= t('contato.revogarTitulo') %></h2>
    <p><%= t('contato.revogarTexto') %></p>
    <ul>
      <% t('contato.revogar').forEach(function (item) { %>
        <li><%- item %></li>
      <% }); %>
    </ul>

    <h2><%= t('contato.documentosTitulo') %></h2>
    <ul>
      <li><a href="/termos"><%= t('rodape.termos') %></a></li>
      <li><a href="/privacidade"><%= t('rodape.privacidade') %></a></li>
    </ul>
  </article>
</div>

<%- include('../partials/public-footer') %>
