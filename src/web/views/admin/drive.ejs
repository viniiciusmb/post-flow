<%- include('../partials/header') %>

<h1>Google Drive</h1>

<% if (googleConnected) { %>
  <p style="color: var(--pico-ins-color);">Google Drive conectado com sucesso!</p>
<% } %>
<% if (googleError) { %>
  <p style="color: var(--pico-del-color);">Nao foi possivel conectar: <%= googleError %></p>
<% } %>
<% if (folderSaved === 'geral') { %>
  <p style="color: var(--pico-ins-color);">Pasta Geral salva com sucesso!</p>
<% } else if (folderSaved === 'cliente') { %>
  <p style="color: var(--pico-ins-color);">Pasta do cliente salva com sucesso!</p>
<% } %>
<% if (folderError) { %>
  <p style="color: var(--pico-del-color);"><%= folderError %></p>
<% } %>

<article>
  <h3>Conexao</h3>
  <% if (connection) { %>
    <p>Conectado como: <strong><%= connection.google_account_email %></strong></p>
    <a href="/auth/google/connect" role="button" class="secondary outline">Reconectar / trocar de conta</a>
  <% } else { %>
    <p>Nenhuma conta Google conectada ainda. Conecte a conta do Drive onde ficam a pasta Geral e as pastas dos clientes.</p>
    <a href="/auth/google/connect" role="button">Conectar Google Drive</a>
  <% } %>
</article>

<article>
  <h3>Pasta Geral</h3>
  <p>Videos colocados aqui sao enviados automaticamente pra todos os clientes ativos (que nao tiverem optado por nao receber).</p>
  <% const general = folders.find(f => f.type === 'general'); %>
  <% if (general) { %>
    <p>Pasta atual: <strong><%= general.folder_name || general.drive_folder_id %></strong></p>
  <% } %>
  <form method="post" action="/admin/drive/general-folder">
    <label>
      Link ou ID da pasta no Google Drive
      <input type="text" name="folderLink" placeholder="https://drive.google.com/drive/folders/..." required>
    </label>
    <label>
      Nome (opcional, so pra identificar aqui no painel)
      <input type="text" name="folderName" placeholder="Pasta Geral">
    </label>
    <button type="submit"><%= general ? 'Trocar pasta' : 'Definir pasta' %></button>
  </form>
</article>

<article>
  <h3>Pasta por cliente</h3>
  <p>Videos colocados na pasta de um cliente sao enviados so pra conta TikTok daquele cliente.</p>

  <% if (clients.length === 0) { %>
    <p class="empty-state">Nenhum cliente cadastrado ainda.</p>
  <% } else { %>
    <form method="post" action="/admin/drive/client-folder">
      <label>
        Cliente
        <select name="clientUserId" required>
          <option value="">Selecione...</option>
          <% clients.forEach(function (c) { %>
            <option value="<%= c.id %>"><%= c.business_name || c.email %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Link ou ID da pasta no Google Drive
        <input type="text" name="folderLink" placeholder="https://drive.google.com/drive/folders/..." required>
      </label>
      <label>
        Nome (opcional)
        <input type="text" name="folderName" placeholder="Pasta do cliente X">
      </label>
      <button type="submit">Salvar pasta do cliente</button>
    </form>
  <% } %>

  <% const clientFolders = folders.filter(f => f.type === 'client'); %>
  <% if (clientFolders.length > 0) { %>
    <h4>Pastas cadastradas</h4>
    <figure>
      <table>
        <thead>
          <tr><th>Cliente</th><th>Pasta</th><th>Ultima checagem</th></tr>
        </thead>
        <tbody>
          <% clientFolders.forEach(function (f) { %>
            <% const owner = clients.find(c => c.id === f.client_user_id); %>
            <tr>
              <td><%= owner ? (owner.business_name || owner.email) : ('cliente #' + f.client_user_id) %></td>
              <td><%= f.folder_name || f.drive_folder_id %></td>
              <td><%= f.last_polled_at ? new Date(f.last_polled_at).toLocaleString('pt-BR') : 'ainda nao checada' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </figure>
  <% } %>
</article>

<%- include('../partials/footer') %>
