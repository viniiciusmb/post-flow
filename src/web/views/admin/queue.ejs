<%- include('../partials/header') %>

<h1>Fila de Processamento</h1>
<p>Cortes de YouTube sao processados um vídeo por vez.</p>

<article>
  <h3>Processando agora</h3>
  <% if (processing) { %>
    <p>
      <strong><%= processing.client_business_name || processing.client_email %></strong> —
      "<%= processing.title %>" (<%= processing.channel_name %>)
      <br>
      <%- include('../partials/status-badge', { status: processing.status }) %>
      <span class="empty-state" style="display:inline; padding:0;">
        atualizado em <%= new Date(processing.updated_at).toLocaleString('pt-BR') %>
      </span>
    </p>
  <% } else { %>
    <p class="empty-state">Fila livre — nada sendo processado agora.</p>
  <% } %>
</article>

<h2>Na fila</h2>
<% if (waiting.length === 0) { %>
  <p class="empty-state">Nada esperando.</p>
<% } else { %>
  <figure>
    <table>
      <thead>
        <tr><th>#</th><th>Cliente</th><th>Vídeo</th><th>Canal</th><th>Detectado em</th></tr>
      </thead>
      <tbody>
        <% waiting.forEach(function (v, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= v.client_business_name || v.client_email %></td>
            <td><%= v.title %></td>
            <td><%= v.channel_name %></td>
            <td><%= new Date(v.created_at).toLocaleString('pt-BR') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </figure>
<% } %>

<h2>Histórico recente</h2>
<% if (history.length === 0) { %>
  <p class="empty-state">Nenhum processamento concluído ainda.</p>
<% } else { %>
  <figure>
    <table>
      <thead>
        <tr><th>Cliente</th><th>Vídeo</th><th>Status</th><th>Erro</th><th>Atualizado em</th><th></th></tr>
      </thead>
      <tbody>
        <% history.forEach(function (v) { %>
          <tr>
            <td><%= v.client_business_name || v.client_email %></td>
            <td><%= v.title %></td>
            <td><%- include('../partials/status-badge', { status: v.status }) %></td>
            <td><%= v.error_message || '—' %></td>
            <td><%= new Date(v.updated_at).toLocaleString('pt-BR') %></td>
            <td>
              <% if (v.status === 'error') { %>
                <form method="post" action="/admin/queue/<%= v.id %>/retry" style="margin:0">
                  <button type="submit" class="secondary outline">Tentar novamente</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </figure>
<% } %>

<%- include('../partials/footer') %>
