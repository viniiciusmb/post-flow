<%- include('../partials/header') %>

<h1>Postagens</h1>

<% if (postings.length === 0) { %>
  <p class="empty-state">Nenhuma postagem ainda.</p>
<% } else { %>
  <figure>
    <table>
      <thead>
        <tr><th>Cliente</th><th>Video</th><th>Status</th><th>Erro</th><th>Criado em</th></tr>
      </thead>
      <tbody>
        <% postings.forEach(function (p) { %>
          <tr>
            <td><%= p.client_business_name || p.client_email %></td>
            <td><%= p.filename %></td>
            <td><%- include('../partials/status-badge', { status: p.status }) %></td>
            <td><%= p.error_message || '—' %></td>
            <td><%= new Date(p.created_at).toLocaleString('pt-BR') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </figure>
<% } %>

<%- include('../partials/footer') %>
