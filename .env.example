# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o git.

# --- Ambiente ---
NODE_ENV=development
PORT=3000

# --- Banco de dados PostgreSQL ---
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://postflow:postflow@localhost:5432/postflow

# --- Sessao / login ---
# Chave secreta usada para assinar o cookie de sessao. Gere uma string
# aleatoria longa, por exemplo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-esta-chave-por-uma-aleatoria

# --- Criptografia de tokens (TikTok/Google) ---
# Chave usada para criptografar tokens salvos no banco (AES-256-GCM).
# Precisa ter exatamente 32 bytes. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=troque-esta-chave-por-32-bytes-em-hex

# --- TikTok (preenchido na Fase 1) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://SEU_DOMINIO/auth/tiktok/callback

# --- Google Drive (preenchido na Fase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://SEU_DOMINIO/auth/google/callback
